# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real secrets.

# Port the Express server listens on
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/airbnb-capstone
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/airbnb-capstone
MONGO_URI=mongodb://127.0.0.1:27017/airbnb-capstone

# Secret used to sign JWTs. Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# How long an issued token stays valid (zeit/ms format: 60s, 24h, 7d)
JWT_EXPIRES_IN=7d

# Origin allowed by CORS. Leave unset to allow all origins in development.
CLIENT_URL=http://localhost:3000
